server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Security headers. They are set here only: nginx drops server-level
    # add_header in any location that has its own add_header, so the locations
    # below use `expires` for caching instead.
    #
    # Session tokens live in localStorage, so the CSP is what keeps an injected
    # script from running. ${API_ORIGIN} is the API the build talks to (the
    # Dockerfile sets it from REACT_APP_API_ENDPOINT). Google sign-in needs
    # accounts.google.com; fonts come from Google Fonts; YouTube thumbnails and
    # profile pictures are images from other https hosts.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: ${API_ORIGIN}; connect-src 'self' ${API_ORIGIN} https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Microphone: the report dialog records voice notes.
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # SPA routing — serve index.html for all non-file routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets (file names are content-hashed)
    location /static/ {
        expires 1y;
    }

    # Disable caching for index.html so users always get latest build
    location = /index.html {
        expires -1;
    }
}
