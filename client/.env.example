# URL of the API server (no trailing slash)
REACT_APP_API_ENDPOINT=http://localhost:5000

# Google OAuth client ID (Google Cloud Console > APIs & Services > Credentials).
# Add your site's origin (e.g. http://localhost:3000) to its "Authorized JavaScript origins".
# The server's GOOGLE_CLIENT_ID must be the same value.
REACT_APP_GOOGLE_CLIENT_ID=
