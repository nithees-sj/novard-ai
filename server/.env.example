# ── Required ────────────────────────────────────────────────────────────────
# MongoDB connection string (local, Docker or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/novard-ai

# Groq API key - powers every AI feature (https://console.groq.com/keys)
GROQ_API_KEY=

# Google OAuth client ID(s) whose sign-in tokens the API accepts (comma-separated).
# Must match the client's REACT_APP_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Secret used to sign session tokens. Required in production; use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Gemini key for Udemy/Coursera/Edureka course discovery (either name works)
GOOGLE_API_KEY=
# GEMINI_API_KEY=

PORT=5000
NODE_ENV=development

# Session lifetime (jsonwebtoken format: 7d, 12h, ...)
# JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API, comma-separated. Empty = any origin.
# CORS_ORIGINS=http://localhost:3000,https://novard.example.com

# Proxy hops in front of the API (Cloud Run / nginx = 1). Defaults to 1 in production.
# TRUST_PROXY=1

# Where uploaded PDFs are stored (relative to the server folder)
# UPLOAD_DIR=uploads

# Rate limits (requests per minute; sign-in attempts per 15 minutes)
# RATE_LIMIT_API_PER_MINUTE=300
# RATE_LIMIT_AI_PER_MINUTE=30
# RATE_LIMIT_AUTH_PER_15_MIN=30
# RATE_LIMIT_ADMIN_AUTH_PER_15_MIN=10
# (Once running, admins change these from the console: Features & limits.)

# ── Admin console ───────────────────────────────────────────────────────────
# Accounts that become superadmin when they sign in (comma-separated). The
# easiest way to create the first admin. Or: npm run admin:grant -- --email you@x --role superadmin
# SUPERADMIN_EMAILS=you@gmail.com
# Admin console session lifetime (shorter than student sessions)
# ADMIN_JWT_EXPIRES_IN=12h
# How long each instance caches runtime settings (ms)
# SETTINGS_CACHE_MS=30000

# Logging: error | warn | info | debug | silent. LOG_FORMAT=json forces JSON lines.
# LOG_LEVEL=info

# Model overrides (see config/ai.js)
# GROQ_MODEL_REASONING=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# MEMORY_SUMMARIZE_AT_TOKENS=10000
# MEMORY_KEEP_RECENT_TOKENS=6000

# When a model's DAILY quota is used up, try these next (comma-separated, in order).
# The per-minute "try again in N s" limit is still simply waited out.
# GROQ_FAILOVER_REASONING=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_FAILOVER_FAST=openai/gpt-oss-20b,openai/gpt-oss-120b
# Voice notes on problem reports (Groq Whisper; voice is hidden when Groq is unavailable)
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Report embeddings for semantic search (needs GOOGLE_API_KEY; without it, text search is used)
# GEMINI_EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=768
# Atlas Vector Search over report embeddings: auto (use it when the cluster supports it), on, off.
# Create the index with: npm run db:vector-index
# VECTOR_SEARCH=auto
# Days model-call and gateway logs are kept (the risk features need 28)
# MODEL_CALL_RETENTION_DAYS=45
